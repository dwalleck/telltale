<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Telltale.Storage.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telltale.Core\Telltale.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every script under Sql/ is embedded as "<folder>/<file>.sql". Adding a table or a view is adding a file. -->
    <EmbeddedResource Include="Sql\**\*.sql" LogicalName="$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))" />
  </ItemGroup>

</Project>
